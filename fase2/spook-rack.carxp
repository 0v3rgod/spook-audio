<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE CARLA-PROJECT>
<CARLA-PROJECT VERSION='2.6' IgnoreClientPrefix='true'>
 <EngineSettings>
  <ForceStereo>false</ForceStereo>
  <PreferPluginBridges>false</PreferPluginBridges>
  <PreferUiBridges>true</PreferUiBridges>
  <UIsAlwaysOnTop>true</UIsAlwaysOnTop>
  <MaxParameters>200</MaxParameters>
  <UIBridgesTimeout>4000</UIBridgesTimeout>
 </EngineSettings>

 <Transport>
  <BeatsPerMinute>120</BeatsPerMinute>
 </Transport>

 <!-- Medidor (INTERNAL do Carla) -->
 <Plugin>
  <Info>
   <Type>INTERNAL</Type>
   <Name>Medidor</Name>
   <Label>bigmeter</Label>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>N</ControlChannel>
   <Options>0x0</Options>
  </Data>
 </Plugin>
</CARLA-PROJECT>
